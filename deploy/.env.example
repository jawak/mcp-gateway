# Copy to deploy/.env (never committed) and fill in before `docker compose up`.
# Every variable is documented inline below; the examples are the reference.

# 32 random bytes as hex: openssl rand -hex 32. Losing this means every stored
# secret must be re-entered; rotating it requires a re-seal.
MCPGW_MASTER_KEY=

# Public origin of this gateway (used for Origin checks and client snippets).
MCPGW_PUBLIC_URL=https://mcp.example.com

# First-run admin; sign in and create real accounts, then unset these.
MCPGW_ADMIN_EMAIL=admin@example.com
MCPGW_ADMIN_PASSWORD=

# Bearer token for GET /metrics. Leave empty to disable the endpoint entirely.
MCPGW_METRICS_TOKEN=

# Behind Caddy: trust one X-Forwarded-For hop so rate limits and the audit trail
# see real client addresses instead of the proxy's.
MCPGW_TRUST_PROXY=true

# Optional image override for local testing.
# MCPGW_IMAGE=mcp-gateway:dev

# How long the worker waits for the gateway to create the schema before giving up,
# so `docker compose up` cannot have it sweep a database that is not migrated yet.
MCPGW_WORKER_WAIT_S=60
