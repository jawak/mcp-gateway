# mcp-gateway environment — copy to .env and fill in.
# Full reference: .agents/2-TECH-SPEC.md → "Variabel environment".
# (validated by src/lib/server/config.ts, task T-03)

# REQUIRED. 32 random bytes as 64 hex chars: openssl rand -hex 32
MCPGW_MASTER_KEY=

# REQUIRED. Public origin used for Origin checks and client snippets.
MCPGW_PUBLIC_URL=https://mcp.example.com

# Bootstrap admin, created on first migration (task T-04)
MCPGW_ADMIN_EMAIL=admin@example.com
MCPGW_ADMIN_PASSWORD=change-me

# Bearer token protecting /metrics
MCPGW_METRICS_TOKEN=

# Server
MCPGW_PORT=8080
MCPGW_HOST=0.0.0.0
MCPGW_DATA_DIR=./data
MCPGW_TRUST_PROXY=true
