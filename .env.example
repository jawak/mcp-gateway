# mcp-gateway environment — copy to .env and fill in.
# Reference: .agents/2-TECH-SPEC.md → "Variabel environment".
# Validated by src/lib/server/config.ts; in production (NODE_ENV=production)
# the two REQUIRED variables below must be set or the gateway refuses to start.

# ── REQUIRED ────────────────────────────────────────────────────────────────
# 32 random bytes as 64 hex chars: openssl rand -hex 32
# Rotating it requires re-sealing stored secrets (see MCPGW_MASTER_KEY_VERSION).
MCPGW_MASTER_KEY=

# Public origin of this gateway. Used for Origin checks and client snippets.
MCPGW_PUBLIC_URL=https://mcp.example.com

# ── bootstrap admin (first migration) ───────────────────────────────────────
MCPGW_ADMIN_EMAIL=admin@example.com
MCPGW_ADMIN_PASSWORD=
MCPGW_MASTER_KEY_VERSION=1

# ── optional ────────────────────────────────────────────────────────────────
# Bearer token for /metrics (min 16 chars). Unset ⇒ /metrics returns 404.
MCPGW_METRICS_TOKEN=
# Session cookie signing key (min 32 chars). Unset ⇒ derived from the master key.
MCPGW_COOKIE_SECRET=

# ── server ──────────────────────────────────────────────────────────────────
MCPGW_HOST=0.0.0.0
MCPGW_PORT=8080
MCPGW_DATA_DIR=./data
MCPGW_LOG_LEVEL=info
# One trusted proxy hop (Caddy) → read X-Forwarded-For for rate limits & audit
MCPGW_TRUST_PROXY=true
# Let remote upstreams point at RFC1918/CGNAT hosts (fully private installs only).
# Link-local/cloud-metadata addresses stay blocked either way.
MCPGW_ALLOW_PRIVATE_NETWORK=false
# Skip certificate verification for upstreams with self-signed certs (use with care)
MCPGW_ALLOW_INSECURE_TLS=false
MCPGW_UPSTREAM_CONNECT_TIMEOUT_S=10
MCPGW_SHUTDOWN_TIMEOUT_S=30
MCPGW_MAX_BODY_BYTES=1048576

# ── gateway behaviour ───────────────────────────────────────────────────────
MCPGW_HEALTH_INTERVAL_S=30
MCPGW_CATALOG_TTL_S=60
MCPGW_SESSION_TTL_MIN=30
MCPGW_MAX_LIVE_UPSTREAMS=20
MCPGW_UPSTREAM_TIMEOUT_MS=60000
MCPGW_UPSTREAM_MAX_TIMEOUT_MS=300000
MCPGW_TOOL_PAYLOAD_LIMIT_BYTES=1048576

# ── debug & retention ───────────────────────────────────────────────────────
# Store (redacted) tool request/response payloads for post-mortems
MCPGW_DEBUG=false
MCPGW_DEBUG_MAX_BYTES=16384
MCPGW_RETENTION_TOOL_CALLS_DAYS=30
MCPGW_RETENTION_AUDIT_DAYS=180
MCPGW_RETENTION_HEALTH_DAYS=7
MCPGW_RETENTION_BACKUPS=14
MCPGW_TZ=UTC
