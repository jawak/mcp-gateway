{
	"name": "mcp-gateway",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "bun run build:app && bun run build:server",
		"build:app": "vite build",
		"build:server": "bun run scripts/build-server.ts",
		"start": "bun build/server.js",
		"worker": "bun build/worker.js",
		"dev:server": "bun run --watch src/entrypoints/server.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run --passWithNoTests",
		"test:unit": "vitest run --project unit --passWithNoTests",
		"test:integration": "vitest run --project integration --passWithNoTests",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^22",
		"chart.js": "^4.5.1",
		"codemirror": "^6.0.2",
		"drizzle-kit": "^0.31.10",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"flowbite": "^4.0.2",
		"flowbite-svelte": "^1.33.1",
		"globals": "^17.6.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.30.0",
		"argon2": "^0.45.1",
		"drizzle-orm": "^0.45.2",
		"pino": "^10.3.1",
		"prom-client": "^15.1.3",
		"yaml": "^2.9.1",
		"zod": "^4.6.5"
	}
}
